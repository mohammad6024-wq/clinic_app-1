{
  "appId": "com.fatemi.clinic",
  "productName": "FatemiClinic",
  "directories": {
    "output": "dist_desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "مدیریت کلینیک فاطمی",
    "artifactName": "${productName}-Setup.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  }
}
