/* ============================================
   تم تیره حرفه‌ای - مدرن و زیبا
   الهام گرفته از VS Code Dark+ و GitHub Dark
   ============================================ */

* {
    font-family: 'Segoe UI', 'Tahoma', sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* ========== دکمه‌ها ========== */
QPushButton {
    background-color: #3c3c3c;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 70px;
    min-height: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4a4a4a;
    border-color: #0e639c;
}

QPushButton:pressed {
    background-color: #2d2d2d;
}

QPushButton[secondary="true"] {
    background-color: #2d2d2d;
    color: #c0c0c0;
}

QPushButton[secondary="true"]:hover {
    background-color: #3c3c3c;
    color: #0e639c;
}

QPushButton[danger="true"] {
    background-color: #5a1e1e;
    color: #f48771;
    border-color: #5a1e1e;
}

QPushButton[danger="true"]:hover {
    border-color: #f48771;
}

QPushButton[success="true"] {
    background-color: #1e3a2a;
    color: #6a9955;
    border-color: #1e3a2a;
}

QPushButton[success="true"]:hover {
    border-color: #6a9955;
}

/* ========== تب‌ها ========== */
QTabWidget::pane {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 12px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #1e1e1e;
    color: #9d9d9d;
    padding: 8px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #252526;
    color: #0e639c;
    border-bottom: 2px solid #0e639c;
}

QTabBar::tab:hover:!selected {
    background-color: #2d2d2d;
    color: #0e639c;
}

/* ========== ورودی‌ها ========== */
QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    padding: 6px 10px;
    color: #d4d4d4;
    selection-background-color: #0e639c;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #0e639c;
    padding: 5px 9px;
}

/* ========== جدول‌ها ========== */
QTableWidget, QTreeView {
    background-color: #252526;
    alternate-background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 12px;
    color: #d4d4d4;
    gridline-color: #3c3c3c;
    outline: 0;
}

QHeaderView::section {
    background-color: #1e1e1e;
    color: #0e639c;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #3c3c3c;
    font-weight: 600;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected, QTreeView::item:selected {
    background-color: #0e639c;
    color: white;
}

/* ========== اسکرول‌بار ========== */
QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #4a4a4a;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5a5a5a;
}

QScrollBar:horizontal {
    background-color: #2d2d2d;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #4a4a4a;
    border-radius: 5px;
    min-width: 30px;
}

/* ========== گروه‌بندی ========== */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: #252526;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #0e639c;
    background-color: #252526;
}

/* ========== لیبل‌ها ========== */
QLabel {
    color: #d4d4d4;
}

QLabel[heading="true"] {
    font-size: 14pt;
    font-weight: 600;
    color: #0e639c;
}

QLabel[subheading="true"] {
    color: #9d9d9d;
}

/* ========== نوار وضعیت ========== */
QStatusBar {
    background-color: #007acc;
    color: white;
    padding: 6px 12px;
}

/* ========== چک باکس و رادیو ========== */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #d4d4d4;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #0e639c;
    background-color: #2d2d2d;
}

QCheckBox::indicator:checked {
    background-color: #0e639c;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #0e639c;
}

/* ========== پیام باکس ========== */
QMessageBox {
    background-color: #2d2d2d;
    color: #d4d4d4;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ========== منو ========== */
QMenu {
    background-color: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px 8px 10px;
    margin: 2px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #0e639c;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 5px;
}

/* ========== کامبوباکس ========== */
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #9d9d9d;
    margin-right: 6px;
}
