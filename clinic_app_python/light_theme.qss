/* ============================================
   تم روشن ملایم - چشم‌دوست و حرفه‌ای
   با کنتراست مناسب و دکمه‌های پررنگ
   ============================================ */

* {
    font-family: 'Segoe UI', 'Tahoma', sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget {
    background-color: #eef2f5;
    color: #2c3e50;
}

/* ========== دکمه‌ها ========== */
QPushButton {
    background-color: #4a7c59;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 70px;
    min-height: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3d6b4a;
}

QPushButton:pressed {
    background-color: #2d5a3a;
}

QPushButton[secondary="true"] {
    background-color: #c8d6e5;
    color: #2c3e50;
    border: 1px solid #b0c4de;
}

QPushButton[secondary="true"]:hover {
    background-color: #b0c4de;
}

QPushButton[danger="true"] {
    background-color: #e74c3c;
    color: white;
}

QPushButton[danger="true"]:hover {
    background-color: #c0392b;
}

QPushButton[success="true"] {
    background-color: #27ae60;
    color: white;
}

QPushButton[success="true"]:hover {
    background-color: #219a52;
}

/* ========== تب‌ها ========== */
QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #d5dce0;
    border-radius: 12px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #eef2f5;
    color: #5d6d7e;
    padding: 8px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #4a7c59;
    border-bottom: 2px solid #4a7c59;
}

QTabBar::tab:hover:!selected {
    background-color: #e2e8ed;
    color: #4a7c59;
}

/* ========== ورودی‌ها ========== */
QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d5dce0;
    border-radius: 8px;
    padding: 6px 10px;
    color: #2c3e50;
    selection-background-color: #4a7c59;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #4a7c59;
    padding: 5px 9px;
}

/* ========== جدول‌ها ========== */
QTableWidget, QTreeView {
    background-color: #ffffff;
    alternate-background-color: #f5f7fa;
    border: 1px solid #d5dce0;
    border-radius: 12px;
    color: #2c3e50;
    gridline-color: #e2e8ed;
    outline: 0;
}

QHeaderView::section {
    background-color: #eef2f5;
    color: #4a7c59;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #4a7c59;
    font-weight: 600;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected, QTreeView::item:selected {
    background-color: #4a7c59;
    color: white;
}

/* ========== اسکرول‌بار ========== */
QScrollBar:vertical {
    background-color: #eef2f5;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #c0cbd6;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0b0c0;
}

QScrollBar:horizontal {
    background-color: #eef2f5;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #c0cbd6;
    border-radius: 5px;
    min-width: 30px;
}

/* ========== گروه‌بندی ========== */
QGroupBox {
    border: 1px solid #d5dce0;
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: #ffffff;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #4a7c59;
    background-color: #ffffff;
}

/* ========== لیبل‌ها ========== */
QLabel {
    color: #2c3e50;
}

QLabel[heading="true"] {
    font-size: 14pt;
    font-weight: 600;
    color: #4a7c59;
}

QLabel[subheading="true"] {
    color: #7f8c8d;
}

/* ========== نوار وضعیت ========== */
QStatusBar {
    background-color: #4a7c59;
    color: white;
    padding: 6px 12px;
}

/* ========== چک باکس و رادیو ========== */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #2c3e50;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #4a7c59;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #4a7c59;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #4a7c59;
}

/* ========== پیام باکس ========== */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ========== منو ========== */
QMenu {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d5dce0;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px 8px 10px;
    margin: 2px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #4a7c59;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #e2e8ed;
    margin: 5px;
}

/* ========== کامبوباکس ========== */
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #5d6d7e;
    margin-right: 6px;
}

/* ========== فریم ========== */
QFrame {
    border-radius: 8px;
}

/* ========== اسکرول اریا ========== */
QScrollArea {
    border: none;
    background-color: transparent;
}
