/* ============================================
   استایل اجباری متریال (برای همه ویجت‌ها)
   ============================================ */

* {
    font-family: 'Segoe UI', 'Tahoma';
    font-size: 13px;
}

QMainWindow, QWidget {
    background-color: #1e1e2e;
}

/* دکمه‌ها */
QPushButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #b4befe;
}

QPushButton:pressed {
    background-color: #6c7086;
}

/* دکمه خطرناک */
QPushButton[danger="true"] {
    background-color: #f38ba8;
}

/* دکمه موفقیت */
QPushButton[success="true"] {
    background-color: #a6e3a1;
}

/* تب‌ها */
QTabWidget::pane {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 10px;
}

QTabBar::tab {
    background-color: #45475a;
    color: #cdd6f4;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #89b4fa;
    color: #1e1e2e;
}

QTabBar::tab:hover:!selected {
    background-color: #585b70;
}

/* ورودی‌ها */
QLineEdit, QTextEdit, QComboBox, QDateEdit {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 8px 12px;
    color: #cdd6f4;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #89b4fa;
}

/* جدول‌ها */
QTableWidget, QTreeView {
    background-color: #313244;
    alternate-background-color: #45475a;
    border: 1px solid #45475a;
    border-radius: 10px;
    color: #cdd6f4;
    gridline-color: #45475a;
}

QHeaderView::section {
    background-color: #1e1e2e;
    color: #89b4fa;
    padding: 10px;
    border: none;
    font-weight: bold;
}

QTableWidget::item:selected, QTreeView::item:selected {
    background-color: #89b4fa;
    color: #1e1e2e;
}

/* اسکرول بار */
QScrollBar:vertical {
    background-color: #313244;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #89b4fa;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #b4befe;
}

QScrollBar:horizontal {
    background-color: #313244;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #89b4fa;
    border-radius: 4px;
    min-width: 30px;
}

/* گروه‌بندی */
QGroupBox {
    border: 1px solid #45475a;
    border-radius: 10px;
    margin-top: 16px;
    padding-top: 16px;
    color: #cdd6f4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #89b4fa;
}

/* لیبل‌ها */
QLabel {
    color: #cdd6f4;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #89b4fa;
}

/* نوار وضعیت */
QStatusBar {
    background-color: #313244;
    color: #a6adc8;
    border-top: 1px solid #45475a;
}

/* چک باکس */
QCheckBox {
    color: #cdd6f4;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #89b4fa;
}

QCheckBox::indicator:checked {
    background-color: #89b4fa;
}

/* پیام باکس */
QMessageBox {
    background-color: #313244;
    color: #cdd6f4;
}

QMessageBox QPushButton {
    min-width: 80px;
}
